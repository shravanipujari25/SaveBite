# SaveBite Frontend Environment Variables
# Copy to .env for local development

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_USE_MOCKS=false

# Application Metadata
VITE_APP_NAME=SaveBite
VITE_APP_TAGLINE="Save Food. Save Money. Waste Less."

# Supabase Auth & Realtime Configuration
# Optional: Left blank will run in local mock auth mode
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# IoT & Telemetry Realtime Broker (Optional)
VITE_MQTT_BROKER_URL=wss://broker.savebite.local:8884/mqtt
