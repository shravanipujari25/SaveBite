.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# TypeScript and ESLint caches
*.tsbuildinfo
.eslintcache
.tern-port

# Node.js tools
.lock-wscript
.node_repl_history
*.tgz
.yarn-integrity
.dynamodb/

# Backup files
**/*.backup.*
**/*.back.*
*.bak
*.tmp

# Design files
*.sublime*
*.psd
*.sketch
*.thumb

# Python virtual environments
.venv/
venv/
env/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/

# AI datasets and generated artifacts
ai/data/
ai/models/*.joblib
ai/models/*.pkl

# Local databases
*.sqlite
*.sqlite3
*.db

# IDE settings
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini

# Temporary editor files
*~
*.swp
*.swo

# Supabase local development
supabase/.temp/

