logs/
*.log
npm-debug.log*
npm-debug.log.*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Testing and coverage
coverage/
*.lcov
.nyc_output/
lib-cov/
.vscode-test/

# Build output
dist/
build/
build/Release/
out/
.next/
.nuxt/
.vuepress/dist/
.serverless/

# Package manager and caches
.npm/
.cache/
.parcel-cache/
.grunt/
.fusebox/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
