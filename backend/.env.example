# ==============================================================================
# SaveBite Backend Environment Variables
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL for Strict CORS Protection
FRONTEND_URL=http://localhost:5173

# Supabase Project URL (Used strictly for PostgreSQL database hosting)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Publishable / Anon Key (Safe for client-facing/public operations)
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Supabase Secret / Service Role Key (Server-only, elevated database access)
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Custom JWT Authentication Configuration
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Pino Logging Level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Rate Limiting Configuration (in milliseconds and request counts)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=60
TELEMETRY_RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=40

# MQTT IoT Broker Configuration (Optional in development)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=savebite-backend-subscriber
MQTT_TELEMETRY_TOPIC=savebite/+/+/telemetry

# Operational Sensor Thresholds (Non-AI preliminary thresholds)
TEMP_HIGH_ALERT_C=10.0
TEMP_LOW_ALERT_C=-2.0
AIR_QUALITY_ALERT_RAW=400.0

# Phase 3: AI Service, Receipts Storage & Barcode Configuration
AI_SERVICE_URL=http://localhost:8000
SUPABASE_RECEIPTS_BUCKET=receipts
RECEIPT_MAX_FILE_SIZE_MB=10
RECEIPT_AUTO_CREATE_CONFIDENCE=0.85
AI_REQUEST_TIMEOUT_MS=15000
OPEN_FOOD_FACTS_TIMEOUT_MS=10000

# Phase 4: Scheduler & Intelligence Configuration
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
USE_FIRST_ALERT_THRESHOLD=70
SHELF_LIFE_ALERT_THRESHOLD_DAYS=2.0


